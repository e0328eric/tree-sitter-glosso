{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "glosso",
      "camelcase": "Glosso",
      "title": "Glosso",
      "scope": "source.glosso",
      "file-types": [
        "glo"
      ],
      "injection-regex": "^glosso$",
      "class-name": "TreeSitterGlosso"
    }
  ],
  "metadata": {
    "version": "0.0.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Glosso",
    "authors": [
      {
        "name": "Sungbae Jeong",
        "email": "almagest0328@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/e0328eric/glosso"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
