    while true {}
}

error := 0;
// <- variable

cleanup :: (owner: Owner) {
//          ^ variable.parameter
    #on_drop_error(owner, error) {
//  ^ attribute
//                 ^ variable.parameter
//                        ^ variable.parameter
        consume(error, owner);
//              ^ variable.parameter
