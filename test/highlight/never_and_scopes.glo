Never :: #Never;
//       ^ type.builtin

halt :: () -> #Never {
//            ^ type.builtin
    while true {}
}

error := 0;
// <- variable

cleanup :: (owner: Owner) {
//          ^ variable.parameter
    #temp_scope {
//  ^ attribute
        consume(error, owner);
//              ^ variable
//                     ^ variable.parameter
    }
}
